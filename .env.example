# Copie para .env (nunca versionado) e ajuste.

# Chave HMAC da pseudonimizacao de IDs. Em producao: chave SECRETA vinda de um cofre.
# Sem ela o pipeline usa uma chave publica de desenvolvimento (pseudonimos apenas ilustrativos).
ID_SALT=fiap-fase4-dev-salt

# Pushgateway para os estagios batch publicarem status/duracao (opcional)
# PUSHGATEWAY_URL=http://localhost:9091

